# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workflow

# JWT Configuration
JWT_SECRET=your_jwt_secret_key

# Application Port & Client URL
PORT=3001
FRONTEND_URL=http://localhost:3000

# Cloudflare R2 / AWS S3 Object Storage Configuration
# Option A: Cloudflare R2 (Recommended for zero egress fees)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev

# Option B: Standard AWS S3 / MinIO (Optional alternative)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=your_s3_bucket_name
# AWS_REGION=us-east-1
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# Transactional Mail Configuration (Resend, SendGrid, Postmark, AWS SES, Gmail, Mailpit)
# Note: If unconfigured, runs in DEV mode where email links are logged to console
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_your_api_key
SMTP_FROM="WorkFlow" <no-reply@yourdomain.com>
# Or Gmail:
# SMTP_SERVICE=gmail
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_google_app_password

# WebRTC ICE Servers (STUN & Enterprise TURN configuration)
# STUN servers (defaults to Google STUN servers if unset)
STUN_SERVER_URL=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN server for symmetric NAT & enterprise firewall traversal:
TURN_SERVER_URL=turn:turn.yourcompany.com:3478?transport=udp
TURN_USERNAME=workflow_user
TURN_CREDENTIAL=workflow_turn_secret
